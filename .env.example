# ============================================
# Django Core
# ============================================
# Local development
DEBUG=True
SECRET_KEY=django-insecure-change-this-local-dev-key-only

# Comma-separated hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# Database (Choose ONE mode)
# ============================================
# Mode A: Use local PostgreSQL via DB_* vars
DB_NAME=aviansense_db
DB_USER=aviansense_user
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432

# Mode B: Use Render PostgreSQL locally (uncomment and set)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================
# Firebase
# ============================================
# Local file path (recommended for local dev)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Alternative for cloud/Render only (single-line JSON string)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# ============================================
# CORS / CSRF
# ============================================
# Local dev default is permissive when DEBUG=True
# In production set CORS_ALLOW_ALL_ORIGINS=False and provide explicit origins
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com

# ============================================
# Production hardening (used when DEBUG=False)
# ============================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
